<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Chat - Teaching Assistant</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background: #f9f9f9;
            color: #2c2c2c;
            height: 100vh;
            overflow: hidden;
        }

        .container {
            display: flex;
            height: 100vh;
        }

        .sidebar {
            width: 300px;
            background: white;
            border-right: 1px solid #e5e5e5;
            overflow-y: auto;
            padding: 20px;
        }

        .sidebar h3 {
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 15px;
            color: #666;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .sidebar-section {
            margin-bottom: 30px;
        }

        .sidebar-content {
            background: #f5f5f5;
            padding: 15px;
            border-radius: 8px;
            font-size: 13px;
            line-height: 1.6;
            white-space: pre-wrap;
            max-height: 400px;
            overflow-y: auto;
        }

        .main {
            flex: 1;
            display: flex;
            flex-direction: column;
            background: white;
        }

        .header {
            padding: 20px 30px;
            border-bottom: 1px solid #e5e5e5;
        }

        .header h1 {
            font-size: 20px;
            font-weight: 600;
        }

        .chat-container {
            flex: 1;
            overflow-y: auto;
            padding: 30px;
        }

        .message {
            margin-bottom: 25px;
            display: flex;
            gap: 15px;
        }

        .message.user {
            flex-direction: row-reverse;
        }

        .avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 14px;
        }

        .message.user .avatar {
            background: #2c2c2c;
            color: white;
        }

        .message.assistant .avatar {
            background: #e5e5e5;
            color: #2c2c2c;
        }

        .message-content {
            max-width: 70%;
            line-height: 1.6;
        }

        .message.user .message-content {
            background: #2c2c2c;
            color: white;
            padding: 12px 16px;
            border-radius: 18px;
        }

        .message.assistant .message-content {
            padding: 12px 0;
        }

        .input-container {
            padding: 20px 30px;
            border-top: 1px solid #e5e5e5;
        }

        .input-wrapper {
            display: flex;
            gap: 10px;
            align-items: center;
            background: #f5f5f5;
            border-radius: 24px;
            padding: 10px 20px;
        }

        .input-wrapper:focus-within {
            background: #ebebeb;
        }

        #messageInput {
            flex: 1;
            border: none;
            background: transparent;
            font-size: 15px;
            outline: none;
            font-family: inherit;
        }

        #sendButton {
            background: #2c2c2c;
            color: white;
            border: none;
            padding: 8px 20px;
            border-radius: 16px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 500;
            transition: background 0.2s;
        }

        #sendButton:hover {
            background: #1a1a1a;
        }

        #sendButton:disabled {
            background: #ccc;
            cursor: not-allowed;
        }

        @media (max-width: 768px) {
            .sidebar {
                display: none;
            }
            
            .message-content {
                max-width: 85%;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="sidebar">
            <div class="sidebar-section">
                <h3>System Prompt</h3>
                <div class="sidebar-content" id="systemPrompt">Loading...</div>
            </div>
            
            <div class="sidebar-section">
                <h3>Class Materials</h3>
                <div class="sidebar-content" id="classMaterials">Loading...</div>
            </div>
        </div>

        <div class="main">
            <div class="header">
                <h1>🎓 AI Teaching Assistant</h1>
            </div>

            <div class="chat-container" id="chatContainer">
                <div class="message assistant">
                    <div class="avatar">AI</div>
                    <div class="message-content">
                        Hello! I'm your AI teaching assistant. Ask me anything about the course materials!
                    </div>
                </div>
            </div>

            <div class="input-container">
                <div class="input-wrapper">
                    <input 
                        type="text" 
                        id="messageInput" 
                        placeholder="Ask a question about the course..."
                        autocomplete="off"
                    />
                    <button id="sendButton">Send</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        const chatContainer = document.getElementById('chatContainer');
        const messageInput = document.getElementById('messageInput');
        const sendButton = document.getElementById('sendButton');
        const API_URL = '';

        let conversationHistory = [];
        let currentMessageDiv = null;

        // Load materials on startup
        async function loadMaterials() {
            try {
                const response = await fetch(`${API_URL}/materials`);
                const data = await response.json();
                document.getElementById('systemPrompt').textContent = data.system_prompt;
                document.getElementById('classMaterials').textContent = data.class_materials;
            } catch (error) {
                console.error('Error loading materials:', error);
            }
        }

        function addMessage(content, isUser) {
            const messageDiv = document.createElement('div');
            messageDiv.className = `message ${isUser ? 'user' : 'assistant'}`;
            
            const avatar = document.createElement('div');
            avatar.className = 'avatar';
            avatar.textContent = isUser ? 'U' : 'AI';
            
            const contentDiv = document.createElement('div');
            contentDiv.className = 'message-content';
            contentDiv.textContent = content;
            
            messageDiv.appendChild(avatar);
            messageDiv.appendChild(contentDiv);
            chatContainer.appendChild(messageDiv);
            
            chatContainer.scrollTop = chatContainer.scrollHeight;
            
            return contentDiv;
        }

        async function sendMessage() {
            const message = messageInput.value.trim();
            if (!message) return;

            addMessage(message, true);
            conversationHistory.push({ role: 'user', content: message });
            
            messageInput.value = '';
            sendButton.disabled = true;

            currentMessageDiv = addMessage('', false);

            try {
                const response = await fetch(`${API_URL}/chat`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        message: message,
                        history: conversationHistory.slice(0, -1)
                    })
                });

                const reader = response.body.getReader();
                const decoder = new TextDecoder();
                let fullResponse = '';

                while (true) {
                    const { done, value } = await reader.read();
                    if (done) break;

                    const chunk = decoder.decode(value);
                    const lines = chunk.split('\n');

                    for (const line of lines) {
                        if (line.startsWith('data: ')) {
                            const data = JSON.parse(line.slice(6));
                            if (data.content) {
                                fullResponse += data.content;
                                currentMessageDiv.textContent = fullResponse;
                                chatContainer.scrollTop = chatContainer.scrollHeight;
                            }
                            if (data.error) {
                                currentMessageDiv.textContent = `Error: ${data.error}`;
                            }
                        }
                    }
                }

                conversationHistory.push({ role: 'assistant', content: fullResponse });

            } catch (error) {
                currentMessageDiv.textContent = 'Sorry, there was an error connecting to the AI.';
                console.error('Error:', error);
            } finally {
                sendButton.disabled = false;
                messageInput.focus();
            }
        }

        sendButton.addEventListener('click', sendMessage);
        messageInput.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') sendMessage();
        });

        // Load materials on page load
        loadMaterials();
    </script>
</body>
</html>
